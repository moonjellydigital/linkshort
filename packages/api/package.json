{
  "name": "@linkshort/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fastify API, redirect handler and static host for the web client.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "10.1.4",
    "@linkshort/shared": "workspace:*",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
